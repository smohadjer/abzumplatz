        {"source": "/select-club", "destination": "/"},
        {"source": "/profile", "destination": "/"},
        {"source": "/profile/edit", "destination": "/"},
        {"source": "/settings", "destination": "/"},
        {"source": "/rules", "destination": "/"},
        {"source": "/support", "destination": "/"},
        {"source": "/faq", "destination": "/"},
        {"source": "/reservations", "destination": "/"},
        {"source": "/bookings", "destination": "/"},
