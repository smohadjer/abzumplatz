{
    "form": {
        "method": "POST",
        "action": "/api/signup",
        "disableBrowserValidation": true,
        "disableClientSideValidation": false
    },
    "fields": [
        {
            "name": "first_name",
            "label": "Vorname",
            "type": "text",
            "required": true,
            "value": ""
        },
        {
            "name": "last_name",
            "label": "Nachname",
            "type": "text",
            "required": true,
            "value": ""
        },
        {
            "name": "email",
            "label": "E-Mail",
            "type": "email",
            "autocomplete": "email",
            "required": true,
            "value": ""
        },
        {
            "name": "password",
            "label": "Passwort",
            "type": "password",
            "autocomplete": "password",
            "required": true,
            "hasStrengthIndicator": true,
            "hasDisplayToggle": true,
            "value": ""
        },
        {
            "name": "club_id",
            "label": "Verein",
            "type": "select",
            "options": [],
            "value": ""
        },
        {
            "name": "privacy",
            "label": "Datenschutz",
            "type": "checkbox",
            "options": [
                {
                    "label": "Datenschutzerklärung gelesen und Nutzungsbedingungen akzeptiert.",
                    "value": "agree"
                }
            ],
            "required": true,
            "value": ""
        }
    ]
}
