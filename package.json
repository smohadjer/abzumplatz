{
  "name": "abzumplatz",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.api.json && vite build && vite build --ssr src/entry-server.tsx --outDir .prerender && node scripts/inject-prerender.js",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "export:db": "node scripts/export-mongodb.js",
    "seed:competition-groups": "node scripts/seed-competition-groups.js",
    "migrate:tournament-registration-user-ids": "node scripts/migrate-tournament-registration-user-ids.js",
    "migrate:tournament-indexes": "node scripts/create-tournament-indexes.js",
    "migrate:remove-tournament-limits": "node scripts/remove-tournament-participant-limits.js",
    "migrate:rename-singles-groups": "node scripts/rename-singles-competition-groups.js",
    "migrate:tournament-groups": "node scripts/migrate-tournament-groups.js",
    "migrate:tournament-statuses": "node scripts/migrate-tournament-statuses.js",
    "backfill:billing-prices": "node scripts/backfill-billing-period-prices.js",
    "backfill:invoice-numbers": "node scripts/backfill-billing-period-invoice-numbers.js",
    "migrate:elite-to-pro": "node scripts/migrate-elite-to-pro.js",
    "release:github": "node scripts/release-github.js"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.7.0",
    "ajv": "^8.20.0",
    "ajv-errors": "^3.0.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "jose": "^6.0.10",
    "mongodb": "^6.16.0",
    "nodemailer": "^9.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-redux": "^9.2.0",
    "react-router": "^7.18.0"
  },
  "devDependencies": {
    "@edge-runtime/cookies": "^6.0.0",
    "@eslint/js": "^9.39.4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.14.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "@vercel/edge": "^1.2.1",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "typescript": "^5.8.3",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild@0.25.12": true
  }
}
